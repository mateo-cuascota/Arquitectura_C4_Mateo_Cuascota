# Copia este archivo como ".env" (en la misma carpeta) y pega la URL de tu Redis en la nube.
# El archivo .env NO se sube a GitHub (esta en .gitignore).
#
# Redis Cloud:  rediss://default:<password>@<host>:<puerto>
# Upstash:      rediss://default:<password>@<nombre>.upstash.io:6379
# Azure Cache:  rediss://:<access-key>@<nombre>.redis.cache.windows.net:6380
REDIS_URL=redis://localhost:6379

# Opcionales
ANT_CACHE_FRESH_TTL=PT30M
ANT_CACHE_TTL=P7D

# Opcional: Registro Civil via Didit (nombre por cédula para personas sin RUC).
# Crea la cuenta en https://business.didit.me (500 consultas gratis al mes) y pega tu API key.
DIDIT_API_KEY=
